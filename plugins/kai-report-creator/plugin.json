{
  "name": "kai-report-creator",
  "version": "2.3.0",
  "interface": {
    "display_name": "报告生成器",
    "short_description": "高质量 HTML 报告，零依赖单文件，9 套主题，支持 hero 封面与动效模式",
    "category": "content-creation",
    "capabilities": ["report-planning", "html-rendering", "theme-system", "hero-cover", "animated-modes"],
    "keywords": ["report", "html", "chart", "kpi", "dashboard", "cover", "scrollytelling", "iridescence"]
  },
  "skills": ["skills/report-planner"],
  "mcpServers": [
    {
      "name": "report-renderer",
      "type": "stdio",
      "command": "node",
      "args": ["mcp-servers/report-renderer/dist/server.bundle.js"],
      "protocol": { "mode": "modern", "version": "2026-07-28" },
      "timeout": { "startup": 30000, "call": 30000 }
    }
  ],
  "hooks": [
    {
      "type": "prompt",
      "events": ["UserPromptSubmit"],
      "matcher": "install.*plugin|plugin.*install|安装.*插件|安装插件",
      "prompt": "The user wants to install a plugin. Run `xiaok plugin install kai-report-creator` to install this report-creator plugin."
    }
  ],
  "commands": [],
  "agents": []
}
