{
  "version": 2,
  "repo": "kaisersong/kai-xiaok-plugins",
  "plugins": [
    {
      "name": "cua-computer-use",
      "display_name": "Computer Use",
      "description": "通过 CUA Driver 观察和操作本机 macOS / Windows 应用",
      "category": "local-automation",
      "keywords": [
        "computer-use",
        "cua",
        "macos",
        "windows",
        "automation",
        "mcp",
        "本机自动化",
        "电脑操作"
      ],
      "repo": "kaisersong/kai-xiaok-plugins",
      "path": "plugins/cua-computer-use",
      "version": "0.3.1",
      "platforms": [
        "darwin",
        "win32"
      ],
      "source": {
        "commit": "56b9df72dfbc4541cab6032d4039e2e208b8be68",
        "treeSha256": "42ec41de366189706459152129d531d7d04e5e5a91347e595f91c9b8c3846c2c"
      },
      "install": {
        "steps": [
          {
            "kind": "external",
            "serverNames": [
              "cua-driver"
            ],
            "reason": "CUA Driver is installed through Xiaok Settings with the platform-specific verified runtime",
            "cwd": "."
          }
        ]
      }
    },
    {
      "name": "kai-infinity-canvas",
      "display_name": "无限画布",
      "description": "tldraw 驱动的本地无限画布，支持手绘、标注、图片插入",
      "category": "visual-collaboration",
      "keywords": [
        "canvas",
        "tldraw",
        "whiteboard",
        "画布",
        "白板",
        "手绘"
      ],
      "repo": "kaisersong/kai-xiaok-plugins",
      "path": "plugins/kai-infinity-canvas",
      "version": "0.3.0",
      "platforms": [
        "darwin",
        "linux",
        "win32"
      ],
      "source": {
        "commit": "56b9df72dfbc4541cab6032d4039e2e208b8be68",
        "treeSha256": "56316fc1bc96e9961fe3054b41be4b81e32d105cb61196498e1a745bf11628c6"
      },
      "install": {
        "steps": [
          {
            "kind": "npm_ci",
            "cwd": "."
          },
          {
            "kind": "npm_run",
            "cwd": ".",
            "script": "build"
          },
          {
            "kind": "npm_ci",
            "cwd": "mcp-servers/canvas-server"
          },
          {
            "kind": "npm_run",
            "cwd": "mcp-servers/canvas-server",
            "script": "build:bundle"
          }
        ]
      }
    },
    {
      "name": "kai-meeting-assistant",
